<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ui.controller.ReportsController"
            fitToWidth="true" styleClass="scroll-container">

    <VBox spacing="20" styleClass="view-container">

        <!-- Top Header & Action -->
        <HBox spacing="14" alignment="CENTER_LEFT">
            <VBox spacing="2">
                <Label text="System Analytics &amp; Reports" styleClass="card-title" />
                <Label text="Financial breakdown, repair throughput, staff workload, and inventory valuation" styleClass="card-subtitle" />
            </VBox>

            <Region HBox.hgrow="ALWAYS" />

            <Button text="🔄 Refresh Analytics" onAction="#handleRefresh" styleClass="btn-secondary" />
        </HBox>

        <!-- 1. Financial Performance Cards -->
        <GridPane hgap="14" vgap="14">
            <columnConstraints>
                <ColumnConstraints percentWidth="20" />
                <ColumnConstraints percentWidth="20" />
                <ColumnConstraints percentWidth="20" />
                <ColumnConstraints percentWidth="20" />
                <ColumnConstraints percentWidth="20" />
            </columnConstraints>

            <!-- Card 1: Realized Revenue -->
            <VBox GridPane.columnIndex="0" styleClass="kpi-card,kpi-emerald">
                <HBox styleClass="kpi-header">
                    <Label text="💵" styleClass="kpi-icon" />
                    <Label text="REALIZED REVENUE" styleClass="kpi-title" />
                </HBox>
                <Label fx:id="lblRealizedRevenue" text="\$0.00" styleClass="kpi-value" />
                <Label text="Paid invoices in cash / card" styleClass="kpi-subtext" />
            </VBox>

            <!-- Card 2: Pending Receivables -->
            <VBox GridPane.columnIndex="1" styleClass="kpi-card,kpi-amber">
                <HBox styleClass="kpi-header">
                    <Label text="⏳" styleClass="kpi-icon" />
                    <Label text="PENDING RECEIVABLES" styleClass="kpi-title" />
                </HBox>
                <Label fx:id="lblPendingReceivables" text="\$0.00" styleClass="kpi-value" />
                <Label text="Outstanding customer invoices" styleClass="kpi-subtext" />
            </VBox>

            <!-- Card 3: Total Invoiced -->
            <VBox GridPane.columnIndex="2" styleClass="kpi-card,kpi-cyan">
                <HBox styleClass="kpi-header">
                    <Label text="🧾" styleClass="kpi-icon" />
                    <Label text="TOTAL INVOICED" styleClass="kpi-title" />
                </HBox>
                <Label fx:id="lblTotalInvoiced" text="\$0.00" styleClass="kpi-value" />
                <Label text="Gross billed repair value" styleClass="kpi-subtext" />
            </VBox>

            <!-- Card 4: Discounts Given -->
            <VBox GridPane.columnIndex="3" styleClass="kpi-card,kpi-purple">
                <HBox styleClass="kpi-header">
                    <Label text="🏷️" styleClass="kpi-icon" />
                    <Label text="DISCOUNTS GRANTED" styleClass="kpi-title" />
                </HBox>
                <Label fx:id="lblDiscountsGiven" text="\$0.00" styleClass="kpi-value" />
                <Label text="Customer promotional savings" styleClass="kpi-subtext" />
            </VBox>

            <!-- Card 5: Average Ticket Value -->
            <VBox GridPane.columnIndex="4" styleClass="kpi-card,kpi-teal">
                <HBox styleClass="kpi-header">
                    <Label text="📊" styleClass="kpi-icon" />
                    <Label text="AVG REPAIR TICKET" styleClass="kpi-title" />
                </HBox>
                <Label fx:id="lblAverageTicket" text="\$0.00" styleClass="kpi-value" />
                <Label text="Average revenue per invoice" styleClass="kpi-subtext" />
            </VBox>
        </GridPane>

        <!-- 2. Two-Column Layout: Job State Funnel & Technician Performance -->
        <HBox spacing="16">
            <!-- Left: Repair State Funnel -->
            <VBox spacing="12" HBox.hgrow="ALWAYS" styleClass="content-card" prefWidth="550">
                <Label text="Repair Lifecycle Status Distribution" styleClass="card-title" />
                <Label text="Current throughput across all state-machine stages" styleClass="card-subtitle" />

                <VBox spacing="8">
                    <!-- INTAKE -->
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label text="1. Intake (Device Received):" prefWidth="180" styleClass="card-subtitle" />
                        <ProgressBar fx:id="pbIntake" prefWidth="200" progress="0.0" />
                        <Label fx:id="lblCountIntake" text="0" styleClass="user-name" />
                    </HBox>

                    <!-- DIAGNOSIS -->
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label text="2. Diagnosis In Progress:" prefWidth="180" styleClass="card-subtitle" />
                        <ProgressBar fx:id="pbDiag" prefWidth="200" progress="0.0" />
                        <Label fx:id="lblCountDiag" text="0" styleClass="user-name" />
                    </HBox>

                    <!-- AWAITING APPROVAL -->
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label text="3. Awaiting Customer Approval:" prefWidth="180" styleClass="card-subtitle" />
                        <ProgressBar fx:id="pbApproval" prefWidth="200" progress="0.0" />
                        <Label fx:id="lblCountApproval" text="0" styleClass="user-name" />
                    </HBox>

                    <!-- REPAIRING -->
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label text="4. Active Repair in Progress:" prefWidth="180" styleClass="card-subtitle" />
                        <ProgressBar fx:id="pbRepair" prefWidth="200" progress="0.0" />
                        <Label fx:id="lblCountRepair" text="0" styleClass="user-name" />
                    </HBox>

                    <!-- QUALITY CHECK -->
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label text="5. Post-Repair Quality Check:" prefWidth="180" styleClass="card-subtitle" />
                        <ProgressBar fx:id="pbQuality" prefWidth="200" progress="0.0" />
                        <Label fx:id="lblCountQuality" text="0" styleClass="user-name" />
                    </HBox>

                    <!-- READY -->
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label text="6. Ready for Collection / Pay:" prefWidth="180" styleClass="card-subtitle" />
                        <ProgressBar fx:id="pbReady" prefWidth="200" progress="0.0" />
                        <Label fx:id="lblCountReady" text="0" styleClass="user-name" />
                    </HBox>

                    <!-- COMPLETED -->
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label text="7. Fully Completed &amp; Settled:" prefWidth="180" styleClass="card-subtitle" />
                        <ProgressBar fx:id="pbCompleted" prefWidth="200" progress="0.0" />
                        <Label fx:id="lblCountCompleted" text="0" styleClass="user-name" />
                    </HBox>

                    <!-- CANCELLED -->
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label text="8. Rejected / Cancelled:" prefWidth="180" styleClass="card-subtitle" />
                        <ProgressBar fx:id="pbCancelled" prefWidth="200" progress="0.0" />
                        <Label fx:id="lblCountCancelled" text="0" styleClass="user-name" />
                    </HBox>
                </VBox>
            </VBox>

            <!-- Right: Technician Productivity Table -->
            <VBox spacing="10" styleClass="content-card" prefWidth="500">
                <Label text="Technician Productivity Matrix" styleClass="card-title" />
                <Label text="Live active workload vs lifetime completed repairs" styleClass="card-subtitle" />

                <TableView fx:id="tblTechStats" prefHeight="260">
                    <columns>
                        <TableColumn fx:id="colTechName" text="Technician" prefWidth="140" />
                        <TableColumn fx:id="colTechSpecialty" text="Specialty" prefWidth="160" />
                        <TableColumn fx:id="colTechActiveJobs" text="Active Jobs" prefWidth="85" />
                        <TableColumn fx:id="colTechCompletedJobs" text="Completed" prefWidth="85" />
                    </columns>
                </TableView>
            </VBox>
        </HBox>

        <!-- 3. Inventory Health Section -->
        <VBox spacing="12" styleClass="content-card">
            <Label text="Inventory Valuation &amp; Supply Health" styleClass="card-title" />

            <HBox spacing="20">
                <VBox spacing="4" styleClass="user-box" HBox.hgrow="ALWAYS">
                    <Label text="Total Catalogue SKUs" styleClass="card-subtitle" />
                    <Label fx:id="lblTotalSKUs" text="0" styleClass="kpi-value" />
                    <Label text="Active unique inventory items tracked" styleClass="kpi-subtext" />
                </VBox>

                <VBox spacing="4" styleClass="user-box" HBox.hgrow="ALWAYS">
                    <Label text="Total Inventory Asset Value" styleClass="card-subtitle" />
                    <Label fx:id="lblTotalInventoryValue" text="\$0.00" styleClass="kpi-value" />
                    <Label text="Sum of (available units × unit selling price)" styleClass="kpi-subtext" />
                </VBox>

                <VBox spacing="4" styleClass="user-box" HBox.hgrow="ALWAYS">
                    <Label text="Low Stock Reorder Alerts" styleClass="card-subtitle" />
                    <Label fx:id="lblLowStockAlertCount" text="0" styleClass="kpi-value" />
                    <Label text="Items at or below 5 units remaining" styleClass="kpi-subtext" />
                </VBox>
            </HBox>
        </VBox>

    </VBox>

</ScrollPane>

