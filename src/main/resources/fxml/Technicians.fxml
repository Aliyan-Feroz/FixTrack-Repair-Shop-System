<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ui.controller.TechniciansController"
      spacing="16" styleClass="view-container">

    <!-- Top Action Bar -->
    <HBox spacing="12" alignment="CENTER_LEFT">
        <HBox spacing="8" alignment="CENTER_LEFT" styleClass="bento-card" prefHeight="40">
            <SVGPath content="M11 19a8 8 0 1 0 0-16 8 8 0 0 0 0 16z M21 21l-4.35-4.35" styleClass="icon-svg" />
            <TextField fx:id="txtSearch" promptText="Search technician or specialty..." prefWidth="300" styleClass="text-field" />
        </HBox>

        <Button text="Refresh" onAction="#handleRefresh" styleClass="btn-secondary">
            <graphic>
                <SVGPath content="M1 4v6h6 M3.51 15a9 9 0 1 0 2.13-9.36L1 10" styleClass="icon-svg" />
            </graphic>
        </Button>

        <Region HBox.hgrow="ALWAYS" />

        <Button text="Add Technician" onAction="#handleAddTechnician" styleClass="btn-primary">
            <graphic>
                <SVGPath content="M12 5v14 M5 12h14" styleClass="icon-btn" />
            </graphic>
        </Button>
    </HBox>

    <!-- Content: TableView + Slide-Over Contextual Detail Drawer -->
    <HBox spacing="16" VBox.vgrow="ALWAYS">
        <!-- Technicians TableView -->
        <VBox spacing="10" HBox.hgrow="ALWAYS" styleClass="bento-card">
            <TableView fx:id="tblTechnicians" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colTechId" text="ID" prefWidth="65" />
                    <TableColumn fx:id="colName" text="Technician Name" prefWidth="220" />
                    <TableColumn fx:id="colSpecialty" text="Specialty" prefWidth="240" />
                    <TableColumn fx:id="colActiveJobs" text="Active Tasks" prefWidth="105" />
                    <TableColumn fx:id="colWorkloadStatus" text="Workload" prefWidth="120" />
                </columns>
            </TableView>
        </VBox>

        <!-- Slide-Over Contextual Detail Drawer -->
        <StackPane styleClass="detail-drawer" prefWidth="380">
            <!-- Empty State Prompt -->
            <VBox fx:id="drawerEmptyState" alignment="CENTER" spacing="12">
                <SVGPath content="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z" styleClass="icon-svg" scaleX="1.6" scaleY="1.6" />
                <Label text="Select a technician to inspect workload" styleClass="bento-label" />
            </VBox>

            <!-- Populated State -->
            <VBox fx:id="drawerContentState" spacing="14" visible="false">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <VBox spacing="2">
                        <Label fx:id="lblSelectedTechName" text="Technician" styleClass="header-title" />
                        <Label fx:id="lblSelectedTechSpecialty" text="Specialty" styleClass="bento-label" />
                    </VBox>
                    <Region HBox.hgrow="ALWAYS" />
                    <HBox alignment="CENTER" spacing="4" styleClass="badge">
                        <Label fx:id="lblSelectedTechActiveJobs" text="0" styleClass="user-name" />
                        <Label text="Active" styleClass="bento-label" />
                    </HBox>
                </HBox>

                <Separator />

                <Label text="ASSIGNED REPAIR TASKS" styleClass="bento-label" />
                <TextArea fx:id="txtAssignedJobs" editable="false" wrapText="true" VBox.vgrow="ALWAYS" prefHeight="300" />
            </VBox>
        </StackPane>
    </HBox>

</VBox>
