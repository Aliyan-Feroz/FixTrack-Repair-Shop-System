<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ui.controller.InventoryController"
      spacing="14" styleClass="view-container">

    <!-- Top Action Bar -->
    <HBox spacing="14" alignment="CENTER_LEFT">
        <TextField fx:id="txtSearch" promptText="🔍  Search parts by name or ID..." prefWidth="320" />
        <CheckBox fx:id="chkLowStockOnly" text="Show Low Stock Only (≤ 5 units)" />
        <Button text="🔄 Refresh" onAction="#handleRefresh" styleClass="btn-secondary" />

        <Region HBox.hgrow="ALWAYS" />

        <Button text="+ Add New Part" onAction="#handleAddPart" styleClass="btn-primary" />
    </HBox>

    <!-- Table Container -->
    <VBox spacing="10" VBox.vgrow="ALWAYS" styleClass="content-card">
        <TableView fx:id="tblInventory" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colPartId" text="Part ID" prefWidth="70" />
                <TableColumn fx:id="colPartName" text="Part Description / Item" prefWidth="280" />
                <TableColumn fx:id="colStock" text="Available Stock" prefWidth="120" />
                <TableColumn fx:id="colPrice" text="Unit Price ($)" prefWidth="120" />
                <TableColumn fx:id="colTotalValue" text="Total Asset Value ($)" prefWidth="150" />
                <TableColumn fx:id="colStatus" text="Stock Status" prefWidth="130" />
            </columns>
        </TableView>

        <!-- Selected Part Actions -->
        <HBox spacing="12" alignment="CENTER_LEFT" styleClass="user-box">
            <Label text="Actions for selected item:" styleClass="card-subtitle" />
            <Button fx:id="btnRestock" text="📥 Restock Units" onAction="#handleRestock" styleClass="btn-primary" />
            <Button fx:id="btnEditPrice" text="💲 Update Price" onAction="#handleEditPrice" styleClass="btn-secondary" />
        </HBox>
    </VBox>

</VBox>

